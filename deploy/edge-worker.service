[Unit]
Description=Inferencia facial local YuNet y SFace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edge
Group=edge
WorkingDirectory=/opt/edge-access
EnvironmentFile=/etc/edge-access/worker.env
ExecStart=/opt/edge-access/worker/.venv/bin/python worker/servidor.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target

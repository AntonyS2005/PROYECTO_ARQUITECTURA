[Unit]
Description=Inferencia facial local YuNet y SFace
After=network-online.target chrony.service
Wants=network-online.target chrony.service

[Service]
Type=simple
User=edge
Group=edge
WorkingDirectory=/opt/edge-access
EnvironmentFile=/etc/edge-access/worker.env
ExecStartPre=/usr/bin/chronyc waitsync 30 1 0 1
ExecStart=/opt/edge-access/worker/.venv/bin/python -m worker.servidor
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
